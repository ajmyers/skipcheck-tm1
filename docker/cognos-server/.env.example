# Copy this file to .env and uncomment what you need. With nothing set, compose
# installs Cognos from the repository zip you put in ./bundles.

# --- Where Cognos comes from (pick one; the default is ./bundles) ---------------
# A folder holding your Cognos repository zip, instead of ./bundles:
# COGNOS_ZIP_DIR=/path/to/ibm-downloads
# Pick one zip if that folder has several (default: the newest):
# COGNOS_ZIP=casrv-12.1.1-2512181837-linuxi38664h.zip
# Download the zip instead (e.g. a pre-signed S3/R2 link), optionally verified:
# COGNOS_ZIP_URL=https://...
# COGNOS_ZIP_SHA256=...
# A private image with Cognos built in (examples/private-image):
# COGNOS_SERVER_IMAGE=registry.example.com/private/cognos-server:12.1.1

# --- Which cognos-server image (default: the published ghcr.io/ajmyers/cognos-server)
# An image you built from the repo (docker build --platform linux/amd64 -t cognos-server:local .):
# COGNOS_SERVER_IMAGE=cognos-server:local

# --- Users (an LDAP namespace; without them, access is anonymous) ----------------
# user:password[:group,group], separated by spaces:
# COGNOS_USERS=admin:adminpw:Admins analyst:analystpw:Analysts,Readers viewer:viewerpw:Readers

# --- Tuning ---------------------------------------------------------------------
# Dispatcher JVM heap in MB (default 6144; 2048 is too small):
# COGNOS_MAX_MEMORY=6144
