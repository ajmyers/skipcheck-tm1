# Lombok settings for every module. See CONTRIBUTING.md for when to use Lombok.
config.stopBubbling = true

# Accessors read like record components: status(), not getStatus()
lombok.accessors.fluent = true

# Mark generated code, so coverage tools skip it
lombok.addLombokGeneratedAnnotation = true

# Features this project doesn't use
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.experimental.flagUsage = warning
