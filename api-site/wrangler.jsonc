// Cloudflare Worker for the projects' pages: each one's landing page, docs and API reference, served
// at skipcheck.io/<project>/ (and on skipcheck.dev).
// The site itself (ajmyers/skipcheck.io) is a separate Worker on the skipcheck.io and skipcheck.dev
// custom domains; a route takes precedence over a custom domain on the same hostname, so these
// paths come here.
// Deployed by .github/workflows/api-docs.yml; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skipcheck-io-docs",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by scripts/assemble.mjs, guide.mjs and pages.mjs
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through the Worker, which adds the site's masthead, footer and headers
    "run_worker_first": true,
    "not_found_handling": "none",
    // Serve files at their own paths: Javadoc links to .html, and the default would redirect each
    // of those to an extensionless URL. The Worker maps a trailing slash to index.html itself.
    "html_handling": "none"
  },
  "vars": {
    // Where the masthead, footer, styles and 404 page come from, and the address every page names
    // as canonical: skipcheck.dev mirrors skipcheck.io, and search engines should index one copy
    "SITE_ORIGIN": "https://skipcheck.io"
  },
  // One route per project and zone: route patterns allow a wildcard only at the start of the
  // hostname and the end of the path. The leading * takes the bare domain and www, both of which
  // serve the site. The projects are the ones in scripts/site.mjs; test/site.test.mjs fails when a
  // project there has no route here.
  "routes": [
    { "pattern": "*skipcheck.io/tm1-client*", "zone_name": "skipcheck.io" },
    { "pattern": "*skipcheck.io/tm1-testcontainers*", "zone_name": "skipcheck.io" },
    { "pattern": "*skipcheck.io/tm1-spring-boot-starter*", "zone_name": "skipcheck.io" },
    { "pattern": "*skipcheck.io/tm1-spring-boot-testcontainers*", "zone_name": "skipcheck.io" },
    { "pattern": "*skipcheck.io/tm1-csdl*", "zone_name": "skipcheck.io" },
    // The docs landing page, which lists every project
    { "pattern": "*skipcheck.io/docs*", "zone_name": "skipcheck.io" },
    // Where these pages were before: /projects/<project>/..., and the guide at /projects/tm1/guide/.
    // The Worker sends them to the addresses above. /projects/pa-docker/ is the site's, and
    // doesn't match.
    { "pattern": "*skipcheck.io/projects/tm1*", "zone_name": "skipcheck.io" },

    // The same on skipcheck.dev
    { "pattern": "*skipcheck.dev/tm1-client*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/tm1-testcontainers*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/tm1-spring-boot-starter*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/tm1-spring-boot-testcontainers*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/tm1-csdl*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/docs*", "zone_name": "skipcheck.dev" },
    { "pattern": "*skipcheck.dev/projects/tm1*", "zone_name": "skipcheck.dev" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
