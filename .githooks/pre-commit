#!/usr/bin/env bash
#
# Formats the Java files a commit stages (./gradlew format: layout, unused imports, import order)
# and stages them again, so checkFormat rarely has anything to fail on.
#
# It never blocks a commit: if anything goes wrong it warns, and the commit goes through as staged;
# the build's checkFormat is the backstop. It leaves alone:
#   - a file with unstaged changes too, since re-staging it would commit those changes as well;
#   - rebases, merges and cherry-picks, which replay commits that were formatted when made;
#   - CI, and any commit made with SKIP_FORMAT_HOOK=1.
# Before formatting, it saves what was staged to refs/format-hook/backup (with a reflog), so
# `git restore --source=refs/format-hook/backup -- <file>` undoes the formatting of a file.
#
# Enabled with the other hooks: git config core.hooksPath .githooks

warn() { echo "[format hook] $*" >&2; }

[[ -n "$SKIP_FORMAT_HOOK" || -n "$CI" || -n "$GITHUB_ACTIONS" ]] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0

for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
	[[ -e "$(git rev-parse --git-path "$state")" ]] && exit 0
done

files=()
while IFS= read -r -d '' file; do
	if [[ -n "$(git diff --name-only -- "$file")" ]]; then
		warn "not formatting $file: it has unstaged changes too"
	else
		files+=("$file")
	fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.java')
[[ ${#files[@]} -eq 0 ]] && exit 0

# The files are fully staged, so the index alone records them as they were
tree="$(git write-tree)" || { warn "couldn't snapshot the index; committing unformatted"; exit 0; }
parent=()
git rev-parse -q --verify HEAD > /dev/null && parent=(-p HEAD)
backup="$(git commit-tree "$tree" "${parent[@]}" -m "format hook: staged files before formatting")" \
	&& git update-ref --create-reflog -m "before formatting ${#files[@]} file(s)" refs/format-hook/backup "$backup" \
	|| { warn "couldn't save a backup; committing unformatted"; exit 0; }

if ! output="$(./gradlew -q format -PformatFiles="$(IFS=,; echo "${files[*]}")" 2>&1)"; then
	warn "formatting failed; committing unformatted"
	echo "$output" | tail -15 >&2
	git checkout -- "${files[@]}"
	exit 0
fi

git add -- "${files[@]}" || warn "couldn't stage the formatted files"
exit 0
