{
	"specVersion": 1,
	"name": "encryption",
	"description": "Encryption at rest on a server that isn't encrypted: every change refused, each step where the server defines it. Before TM1 11.8.040 the server can't make the local key file, so its settings check as invalid and configuring is refused too; from 11.8.040 they check as valid and configuring would convert the server and stop it, so those two steps stop there (encryption-validated checks the settings).",
	"names": [],
	"steps": [
		{
			"service": "encryption",
			"method": "validate",
			"requires": [
				"FunctionImport ValidateEncryptionAtRestSettings"
			],
			"tm1Before": "11.8.04000",
			"params": [
				"settings"
			],
			"args": [
				{
					"$patch": "LocalKeyFileProviderSettingsPatch",
					"json": {
						"@odata.type": "#ibm.tm1.api.v1.LocalKeyFileProviderSettings",
						"KeyRef": "/tmp/tm1-client.key"
					}
				}
			],
			"expect": {
				"fields": {
					"IsValid": false
				}
			}
		},
		{
			"service": "encryption",
			"method": "configure",
			"requires": [
				"ActionImport ConfigureEncryptionAtRest"
			],
			"tm1Before": "11.8.04000",
			"params": [
				"settings"
			],
			"args": [
				{
					"$patch": "LocalKeyFileProviderSettingsPatch",
					"json": {
						"@odata.type": "#ibm.tm1.api.v1.LocalKeyFileProviderSettings",
						"KeyRef": "/tmp/tm1-client.key"
					}
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "disable",
			"requires": [
				"ActionImport DisableEncryptionAtRest"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "rotateDataEncryptionKey",
			"requires": [
				"ActionImport RotateDataEncryptionKey"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "rotateDataModelKey",
			"requires": [
				"ActionImport RotateDataModelKey"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "encryptFile",
			"requires": [
				"ActionImport EncryptDataFile"
			],
			"params": [
				"source",
				"destination",
				"type"
			],
			"args": [
				"tm1s.cfg",
				"/tmp/tm1s.cfg.enc",
				{
					"$enum": "EncryptionFileType",
					"name": "OBJECT",
					"json": "Object"
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "decryptFile",
			"requires": [
				"ActionImport DecryptDataFile"
			],
			"params": [
				"source",
				"destination",
				"type"
			],
			"args": [
				"}clientgroups.cub",
				"/tmp/clientgroups.cub",
				{
					"$enum": "EncryptionFileType",
					"name": "OBJECT",
					"json": "Object"
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		}
	]
}
