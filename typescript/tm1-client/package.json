{
  "name": "@skipcheck/tm1-client",
  "version": "0.1.0-dev",
  "description": "A client for the IBM Planning Analytics (TM1) REST API, with the Java client's API",
  "license": "Apache-2.0",
  "author": "Andrew Myers (https://ajmyers.net)",
  "homepage": "https://skipcheck.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajmyers/skipcheck-tm1.git",
    "directory": "typescript/tm1-client"
  },
  "bugs": "https://github.com/ajmyers/skipcheck-tm1/issues",
  "keywords": [
    "tm1",
    "planning-analytics",
    "ibm",
    "odata",
    "rest-client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/generated/index.d.ts",
      "default": "./dist/generated/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "tsx codegen/main.ts ../../spec/tm1-api.json src/generated",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:live": "vitest run test/live",
    "prepack": "npm run build && node ../scripts/copy-license.mjs"
  },
  "devDependencies": {
    "@skipcheck/tm1-testcontainers": "*",
    "testcontainers": "11.14.0"
  }
}
