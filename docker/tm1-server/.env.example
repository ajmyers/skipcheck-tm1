# Copy this file to .env and uncomment what you need. With nothing set, compose
# installs TM1 from the bundle you put in ./bundles. See GETTING-STARTED.md.

# --- Where TM1 comes from (pick one; the default is ./bundles) ----------------
# A folder holding your IBM bundle, instead of ./bundles:
# TM1_BUNDLE_DIR=/path/to/ibm-downloads
# Pick one bundle if that folder has several (default: the newest):
# TM1_BUNDLE=tm1server-2.1.19-26031712-linuxi38664h_bundle.tar.gz
# Download the bundle instead (e.g. a pre-signed S3/R2 link), optionally verified:
# TM1_BUNDLE_URL=https://...
# TM1_BUNDLE_SHA256=...
# An installed tm1_64 folder (the one containing bin64/):
# TM1_HOME_DIR=/path/to/tm1_64
# A private image with TM1 built in (examples/private-image):
# TM1_SERVER_IMAGE=registry.example.com/private/tm1-server:2.1.19

# --- Which tm1-server image (default: the published ghcr.io/ajmyers/tm1-server) --
# An image you built from the repo (docker build --platform linux/amd64 -t tm1-server:local .):
# TM1_SERVER_IMAGE=tm1-server:local

# --- Where each server's config, data and logs go (default: ./tm1-files) ------
# TM1_FILES_DIR=/path/to/tm1-files
# Or put any of the tm1 server's three elsewhere: another folder (a path starting with
# /, ./ or ~), or the Docker volume named here, and only that one for each setting.
# - Nothing is moved: a server switched to a volume starts empty. The README's
#   "Compose" section has the command that copies your files in first.
# - "docker compose down -v" then removes them with the volume.
# - These need a compose.yaml that names them. If yours is older (a rerun of the setup
#   script keeps it), download compose.yaml again.
# - A variable of the same name exported in your shell wins over this file.
# TM1_CONFIG_DIR=tm1-config
# TM1_DATA_DIR=tm1-data
# TM1_LOGS_DIR=tm1-logs
# The sample server's (docker compose --profile samples):
# TM1_SDATA_CONFIG_DIR=tm1-sdata-config
# TM1_SDATA_DATA_DIR=tm1-sdata-data
# TM1_SDATA_LOGS_DIR=tm1-sdata-logs

# --- TM1 Web (docker compose --profile web) -----------------------------------
# By default, installed from the newest tm1web-*_bundle.tar.gz in the bundles folder.
# Pick one bundle if that folder has several:
# TM1_WEB_BUNDLE=tm1web-11.0.112-26031316-2.1.19-linuxi38664h_bundle.tar.gz
# Download it instead, optionally verified:
# TM1_WEB_BUNDLE_URL=https://...
# TM1_WEB_BUNDLE_SHA256=...
# An installed tm1web folder (the one containing wlp/, jre/ and webapps/):
# TM1_WEB_HOME_DIR=/path/to/tm1web
# An image you built from the repo (docker/tm1-web):
# TM1_WEB_IMAGE=tm1-web:local
