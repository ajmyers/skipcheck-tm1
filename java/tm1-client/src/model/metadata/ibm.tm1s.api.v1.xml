			<Action Name="DisableMaintenanceMode" IsBound="true">
				<Annotation Term="Core.Description">
					<String>Disables maintenance mode for a database, allowing all sessions to access it.</String>
				</Annotation>
				<Annotation Term="Core.LongDescription">
					<String>Disables maintenance mode for the specified database. This mode can be disabled by the session that enabled it or by a member of Admin or OperationsAdmin groups. Once disabled, all sessions can access the database normally.</String>
				</Annotation>
				<Annotation Term="Core.Revisions">
					<Collection>
						<Record>
							<PropertyValue Property="Version">
								<String>12.6.0</String>
							</PropertyValue>
							<PropertyValue Property="Kind">
								<EnumMember>Core.RevisionKind/Added</EnumMember>
							</PropertyValue>
						</Record>
					</Collection>
				</Annotation>
				<Parameter Name="Database" Type="tm1s.Database" Nullable="false">
					<Annotation Term="Core.Description">
						<String>The database to disable maintenance mode for.</String>
					</Annotation>
				</Parameter>
			</Action>
			<Action Name="EnableMaintenanceMode" IsBound="true">
				<Annotation Term="Core.Description">
					<String>Enables maintenance mode for a database, restricting access to only the session that enabled it.</String>
				</Annotation>
				<Annotation Term="Core.LongDescription">
					<String>Enables maintenance mode for the specified database. Only the session that enables maintenance mode can access the database while it is in this state. All other sessions will receive a 503 Service Unavailable response. The operation requires Admin or OperationsAdmin group membership. Maintenance mode is automatically disabled if the session that enabled it is closed or times out.</String>
				</Annotation>
				<Annotation Term="Core.Revisions">
					<Collection>
						<Record>
							<PropertyValue Property="Version">
								<String>12.6.0</String>
							</PropertyValue>
							<PropertyValue Property="Kind">
								<EnumMember>Core.RevisionKind/Added</EnumMember>
							</PropertyValue>
						</Record>
					</Collection>
				</Annotation>
				<Parameter Name="Database" Type="tm1s.Database" Nullable="false">
					<Annotation Term="Core.Description">
						<String>The database to enable maintenance mode for.</String>
					</Annotation>
				</Parameter>
			</Action>
