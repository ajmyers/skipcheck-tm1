{
	"specVersion" : 1,
	"name" : "writes-debug",
	"tm1Before" : "12.0",
	"description" : "Process debug breakpoint create and patch writes on TM1 11 (where EnableTIDebugging is enabled by default; TM1 v12 disables TI debugging by default).",
	"names" : [ "debug", "context" ],
	"steps" : [
		{
			"service" : "processes",
			"method" : "create",
			"params" : [ "process" ],
			"args" : [ { "$patch" : "ProcessCreate", "json" : { "Name" : "${debug}", "PrologProcedure" : "x = 1;\r\ny = 2;\r\nz = 3;\r\n" } } ],
			"expect" : { "fields" : { "Name" : "${debug}" } }
		},
		{
			"service" : "processDebugging",
			"method" : "debug",
			"params" : [ "process", "parameters", "query" ],
			"args" : [ "${debug}", { "$map" : { } }, { "$query" : { } } ],
			"expect" : { "fields" : { } },
			"save" : { "context" : "ID" }
		},
		{
			"service" : "processDebugging",
			"method" : "addBreakpoint",
			"params" : [ "id", "breakpoint" ],
			"args" : [ "${context}", { "$patch" : "ProcessDebugContextLineBreakpointCreate", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextLineBreakpoint", "ID" : 1, "Enabled" : true, "Expression" : "x = 1", "HitCount" : 2, "HitMode" : "BreakEqual", "ProcessName" : "${debug}", "Procedure" : "Prolog", "LineNumber" : 2 } } ],
			"expect" : { "fields" : { "ID" : 1, "LineNumber" : 2, "Procedure" : "Prolog", "ProcessName" : "${debug}" } }
		},
		{
			"service" : "processDebugging",
			"method" : "addBreakpoint",
			"params" : [ "id", "breakpoint" ],
			"args" : [ "${context}", { "$patch" : "ProcessDebugContextDataBreakpointCreate", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextDataBreakpoint", "ID" : 2, "Enabled" : true, "Expression" : "x = 1", "HitCount" : 2, "HitMode" : "BreakEqual", "VariableName" : "y" } } ],
			"expect" : { "fields" : { "ID" : 2, "VariableName" : "y" } }
		},
		{
			"service" : "processDebugging",
			"method" : "addBreakpoint",
			"params" : [ "id", "breakpoint" ],
			"args" : [ "${context}", { "$patch" : "ProcessDebugContextLockBreakpointCreate", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextLockBreakpoint", "ID" : 3, "Enabled" : true, "Expression" : "x = 1", "HitCount" : 2, "HitMode" : "BreakEqual", "ObjectName" : "}ClientGroups", "ObjectType" : "Cube", "LockMode" : "Write" } } ],
			"expect" : { "fields" : { "ID" : 3, "ObjectName" : "}ClientGroups", "ObjectType" : "Cube", "LockMode" : "Write" } }
		},
		{
			"service" : "processDebugging",
			"method" : "breakpoints",
			"params" : [ "id", "query" ],
			"args" : [ "${context}", { "$query" : { } } ],
			"expect" : { "items" : { "ID" : [ 1, 3, 2 ], "Enabled" : [ true, true, true ], "Expression" : [ "x = 1", "x = 1", "x = 1" ], "HitCount" : [ 2, 2, 2 ], "HitMode" : [ "BreakEqual", "BreakEqual", "BreakEqual" ] } }
		},
		{
			"service" : "processDebugging",
			"method" : "updateBreakpoint",
			"params" : [ "id", "breakpoint", "patch" ],
			"args" : [ "${context}", 1, { "$patch" : "ProcessDebugContextLineBreakpointPatch", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextLineBreakpoint", "Enabled" : false, "Expression" : "y = 2", "HitCount" : 3, "HitMode" : "BreakGreaterOrEqual", "ProcessName" : "${debug}", "Procedure" : "Prolog", "LineNumber" : 3 } } ],
			"expect" : { "none" : true }
		},
		{
			"service" : "processDebugging",
			"method" : "updateBreakpoint",
			"params" : [ "id", "breakpoint", "patch" ],
			"args" : [ "${context}", 2, { "$patch" : "ProcessDebugContextDataBreakpointPatch", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextDataBreakpoint", "Enabled" : false, "Expression" : "y = 2", "HitCount" : 3, "HitMode" : "BreakGreaterOrEqual", "VariableName" : "z" } } ],
			"expect" : { "none" : true }
		},
		{
			"service" : "processDebugging",
			"method" : "updateBreakpoint",
			"params" : [ "id", "breakpoint", "patch" ],
			"args" : [ "${context}", 3, { "$patch" : "ProcessDebugContextLockBreakpointPatch", "json" : { "@odata.type" : "#ibm.tm1.api.v1.ProcessDebugContextLockBreakpoint", "Enabled" : false, "Expression" : "y = 2", "HitCount" : 3, "HitMode" : "BreakGreaterOrEqual", "ObjectName" : "}Groups", "ObjectType" : "Dimension", "LockMode" : "Read" } } ],
			"expect" : { "none" : true }
		},
		{
			"service" : "processDebugging",
			"method" : "breakpoints",
			"params" : [ "id", "query" ],
			"args" : [ "${context}", { "$query" : { } } ],
			"expect" : { "items" : { "ID" : [ 1, 3, 2 ], "Enabled" : [ false, false, false ], "Expression" : [ "y = 2", "y = 2", "y = 2" ], "HitCount" : [ 3, 3, 3 ], "HitMode" : [ "BreakGreaterOrEqual", "BreakGreaterOrEqual", "BreakGreaterOrEqual" ] } }
		},
		{
			"service" : "processDebugging",
			"method" : "breakpoints",
			"params" : [ "id", "query" ],
			"args" : [ "${context}", { "$query" : { "filter" : "ID eq 1" } } ],
			"expect" : { "items" : { "LineNumber" : [ 3 ], "Procedure" : [ "Prolog" ], "ProcessName" : [ "${debug}" ] } }
		},
		{
			"service" : "processDebugging",
			"method" : "breakpoints",
			"params" : [ "id", "query" ],
			"args" : [ "${context}", { "$query" : { "filter" : "ID eq 2" } } ],
			"expect" : { "items" : { "VariableName" : [ "z" ] } }
		},
		{
			"service" : "processDebugging",
			"method" : "breakpoints",
			"params" : [ "id", "query" ],
			"args" : [ "${context}", { "$query" : { "filter" : "ID eq 3" } } ],
			"expect" : { "items" : { "ObjectName" : [ "}Groups" ], "ObjectType" : [ "Dimension" ], "LockMode" : [ "Read" ] } }
		},
		{
			"service" : "processDebugging",
			"method" : "finish",
			"params" : [ "id" ],
			"args" : [ "${context}" ],
			"repeats" : "tm1\\.Continue$",
			"expect" : { "fields" : { "Status" : "Complete" } }
		}
	],
	"finally" : [
		{ "service" : "processDebugging", "method" : "finish", "params" : [ "id" ], "args" : [ "${context}" ], "repeats" : "tm1\\.Continue$" },
		{ "service" : "processes", "method" : "delete", "params" : [ "name" ], "args" : [ "${debug}" ] }
	]
}
