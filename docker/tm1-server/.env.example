# Your licensed TM1 Server install directory - the folder that contains bin64/
# (on Linux typically /opt/ibm/cognos/tm1_64). Don't have a Linux install? See
# "Getting a tm1_64 directory" in README.md.
TM1_HOME_DIR=/path/to/tm1_64

# T = REST over https (prod-like, IBM self-signed cert); F = plain http
TM1_USE_SSL=T

# Use the published image instead of building locally (then: docker compose pull)
# TM1_SERVER_IMAGE=ghcr.io/ajmyers/tm1-server:latest
