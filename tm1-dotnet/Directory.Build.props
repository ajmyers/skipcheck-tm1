<Project>
  <!-- Shared by every project: the current LTS, nullable reference types, warnings as errors -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Not followed, each for a reason:
         CA1715, CA1716, CA1720: names kept as the Java client has them (R, Alias, String, Single)
         CA1036: Tm1Version compares as Java's does, with CompareTo, and adds no operators
         CA1859: a private helper returns the type its callers return, not the one it happens to build
         CA1001: Connection disposes its HttpClient when its session closes (CloseAsync)
         CA1848, CA1873: a container logs a line or two as it starts, where speed doesn't matter -->
    <NoWarn>$(NoWarn);CA1715;CA1716;CA1720;CA1036;CA1859;CA1001;CA1848;CA1873</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The repository root, where spec/ lives -->
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepositoryRoot>
    <!-- A build fails on a file CSharpier would reformat (.csharpierrc.json), as the Java build's
         checkFormat: fix with "dotnet csharpier format tm1-dotnet". It never formats during a build. -->
    <CSharpier_Check>true</CSharpier_Check>
  </PropertyGroup>
  <!-- .NET's own analyzers, as the Java build's Error Prone: their findings are errors. For the
       libraries only, as Error Prone's stricter checks are: tests take certificates as they come
       and parse JSON without ceremony. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same version as the tool in dotnet-tools.json: they have to lay code out alike -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.4.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
