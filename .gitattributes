/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# Everything that goes into a Linux image keeps LF line endings, even when checked
# out on Windows (CRLF breaks shell scripts and config inside the container).
/docker/** text eol=lf
*.sh text eol=lf
# The $metadata snapshots are compared with live servers byte for byte: never change their line endings
/java/tm1-client/src/model/metadata/** -text
# Generated by MetadataReleasesTest, which compares it with what it writes, byte for byte
/spec/tm1-versions.md text eol=lf
