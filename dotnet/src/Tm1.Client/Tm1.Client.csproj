<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Skipcheck.Tm1.Client</AssemblyName>
    <RootNamespace>Skipcheck.Tm1.Client</RootNamespace>
    <PackageId>Skipcheck.Tm1.Client</PackageId>
    <Version>0.1.0-dev</Version>
    <Description>.NET client for the IBM Planning Analytics (TM1) REST API, generated from its $metadata</Description>
    <GeneratedDir>$(BaseIntermediateOutputPath)generated/</GeneratedDir>
    <SpecFile>$(RepositoryRoot)/spec/tm1-api.json</SpecFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skipcheck.Tm1.Client.Tests" />
    <!-- Built first, never referenced at run time -->
    <ProjectReference Include="../Tm1.Codegen/Tm1.Codegen.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The model is generated from the spec at build time, into obj/: never committed, as for
       the Java (Gradle) and Python (hatch) clients. A spec change shows up as a diff of the spec. -->
  <Target Name="GenerateTm1Model" BeforeTargets="CoreCompile" Inputs="$(SpecFile);@(Tm1CodegenInputs)" Outputs="$(GeneratedDir).stamp">
    <MSBuild Projects="../Tm1.Codegen/Tm1.Codegen.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="Tm1CodegenDll" />
    </MSBuild>
    <Exec Command="dotnet &quot;$(Tm1CodegenDll)&quot; &quot;$(SpecFile)&quot; &quot;$(GeneratedDir)&quot;" />
    <Touch Files="$(GeneratedDir).stamp" AlwaysCreate="true" />
  </Target>
  <Target Name="IncludeTm1Model" BeforeTargets="CoreCompile" AfterTargets="GenerateTm1Model">
    <ItemGroup>
      <Compile Remove="$(GeneratedDir)**/*.cs" />
      <Compile Include="$(GeneratedDir)**/*.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Tm1CodegenInputs Include="../Tm1.Codegen/**/*.cs" />
  </ItemGroup>
</Project>
