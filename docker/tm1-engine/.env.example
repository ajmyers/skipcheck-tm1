# Settings for compose.yaml. Copy to .env and change what you need; every line is optional.

# --- Where TM1 comes from --------------------------------------------------------------
# By default: the newest tm1-v*-standalone-linux.tgz in ./bundles.
# Another folder holding it:
#TM1_ENGINE_BUNDLE_DIR=/path/to/ibm-downloads
# A particular file in that folder:
#TM1_ENGINE_BUNDLE=tm1-v12.6.7-standalone-linux.tgz
# Or a download link (e.g. a pre-signed S3, R2 or GCS URL), and optionally its SHA-256:
#TM1_ENGINE_BUNDLE_URL=https://...
#TM1_ENGINE_BUNDLE_SHA256=
# Or an image of your own (a local build, or a private image with TM1 built in):
#TM1_ENGINE_IMAGE=tm1-engine:local

# --- What to create ----------------------------------------------------------------------
# Databases, as [instance/]database,... (default: tm1)
#TM1_DATABASES=planning,sales
# Applications, as [instance/]application,... (default: one named tm1 in each instance)
#TM1_APPLICATIONS=tm1,paw
# Users for every database, as user[:group[:group]],...
#TM1_USERS=analyst:Analysts,viewer

# OAuth 2.0 logins: an identity provider TM1 takes tokens from (README, "OAuth 2.0 logins").
# The issuer must be reachable from inside the container, and be what tokens say in "iss".
#TM1_OAUTH2_ISSUER_URL=http://keycloak:8080/realms/tm1
#TM1_OAUTH2_AUDIENCE=tm1
#TM1_OAUTH2_ID_CLAIMS=preferred_username
#TM1_OAUTH2_NAME_CLAIMS=name
# Off again (leaving the lines out keeps what an earlier start set):
#TM1_OAUTH2_ISSUER_URL=none

# --- Where things go ---------------------------------------------------------------------
#TM1_ENGINE_PORT=4444
# Everything is kept in one folder by default: deployment/ (configuration, databases,
# logs), credentials/ and datastore/ (MongoDB's data)
#TM1_ENGINE_FILES_DIR=./tm1-engine-files
# Or put any of the three elsewhere: another folder (a path), or the Docker volume named here
#TM1_ENGINE_DEPLOYMENT_DIR=tm1-engine-deployment
#TM1_ENGINE_CREDENTIALS_DIR=tm1-engine-credentials
#TM1_DATASTORE_DIR=tm1-engine-datastore
# The password of TM1's MongoDB (only TM1 uses it). Letters and digits only: it goes into
# a URL, where other characters would need encoding.
#TM1_DATASTORE_PASSWORD=tm1-datastore
