<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Skipcheck.Tm1.Client.Tests</AssemblyName>
    <RootNamespace>Skipcheck.Tm1.Client.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit's analyzers ask for ConfigureAwait in tests; not useful here -->
    <NoWarn>$(NoWarn);xUnit1031;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tm1.Client/Tm1.Client.csproj" />
    <!-- The live tests start TM1 with it, as the Java ones use tm1-testcontainers -->
    <ProjectReference Include="../../src/Tm1.Testcontainers/Tm1.Testcontainers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
