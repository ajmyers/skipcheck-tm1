{
	"specVersion": 1,
	"name": "encryption",
	"description": "Encryption at rest on a server that isn't encrypted: every change refused, each step where the server defines it. On a read-only install (an installed folder, TM1_HOME_DIR) TM1 can't make the local key, so its settings check as invalid and configuring is refused too. On a writable one they check as valid and configuring would convert the server and stop it, so those two steps run only on a read-only install (encryption-validated checks the settings on a writable one). Whatever the version (#439).",
	"names": [],
	"steps": [
		{
			"service": "encryption",
			"method": "validate",
			"requires": [
				"FunctionImport ValidateEncryptionAtRestSettings"
			],
			"install": "readOnly",
			"params": [
				"settings"
			],
			"args": [
				{
					"$patch": "LocalKeyFileProviderSettingsPatch",
					"json": {
						"@odata.type": "#ibm.tm1.api.v1.LocalKeyFileProviderSettings",
						"KeyRef": "/tmp/tm1-client.key"
					}
				}
			],
			"expect": {
				"fields": {
					"IsValid": false
				}
			}
		},
		{
			"service": "encryption",
			"method": "configure",
			"requires": [
				"ActionImport ConfigureEncryptionAtRest"
			],
			"install": "readOnly",
			"params": [
				"settings"
			],
			"args": [
				{
					"$patch": "LocalKeyFileProviderSettingsPatch",
					"json": {
						"@odata.type": "#ibm.tm1.api.v1.LocalKeyFileProviderSettings",
						"KeyRef": "/tmp/tm1-client.key"
					}
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "disable",
			"requires": [
				"ActionImport DisableEncryptionAtRest"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "rotateDataEncryptionKey",
			"requires": [
				"ActionImport RotateDataEncryptionKey"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "rotateDataModelKey",
			"requires": [
				"ActionImport RotateDataModelKey"
			],
			"params": [],
			"args": [],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "encryptFile",
			"requires": [
				"ActionImport EncryptDataFile"
			],
			"params": [
				"source",
				"destination",
				"type"
			],
			"args": [
				"tm1s.cfg",
				"/tmp/tm1s.cfg.enc",
				{
					"$enum": "EncryptionFileType",
					"name": "OBJECT",
					"json": "Object"
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		},
		{
			"service": "encryption",
			"method": "decryptFile",
			"requires": [
				"ActionImport DecryptDataFile"
			],
			"params": [
				"source",
				"destination",
				"type"
			],
			"args": [
				"}clientgroups.cub",
				"/tmp/clientgroups.cub",
				{
					"$enum": "EncryptionFileType",
					"name": "OBJECT",
					"json": "Object"
				}
			],
			"expect": {
				"error": {
					"category": "api",
					"status": 400
				}
			}
		}
	]
}
