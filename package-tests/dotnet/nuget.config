<?xml version="1.0" encoding="utf-8"?>
<!-- The Skipcheck packages come only from what was just packed (build/packages/dotnet), never from
     nuget.org, where an older or newer release would otherwise be the one that gets tested. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="packed" value="../../build/packages/dotnet" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="Skipcheck.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
