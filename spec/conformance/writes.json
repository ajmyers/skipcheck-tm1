{
	"$comment": "Writes made from what was read, which every client must produce identically: the generated create and patch types' builder(read), by the probe's writes (tm1-api.json's write sections). A case reads `read` as its `type`, builds the `write` (\"create\": <type>Create, \"patch\": <type>Patch) from it, and gets exactly `expect`, compared as JSON (an object's key order doesn't count), or fails building with a message containing `error`. Read by the Java client's WritesConformanceTest and each client's test of the same name. Durations and dates are left out: how each client writes them back is a matter of format, not of what's sent.",
	"cases": [
		{
			"id": "an element's create leaves out what a POST ignores",
			"type": "Element",
			"write": "create",
			"read": {
				"Name": "North",
				"UniqueName": "[Region].[Region].[North]",
				"Type": "Consolidated",
				"Index": 4,
				"Level": 1,
				"Attributes": {
					"Caption": "North"
				}
			},
			"expect": {
				"Name": "North",
				"Type": "Consolidated"
			}
		},
		{
			"id": "a chore's patch leaves out what a PATCH rejects (Attributes, a rename) and the tasks it appends",
			"type": "Chore",
			"write": "patch",
			"read": {
				"Name": "Nightly",
				"Active": true,
				"DSTSensitive": false,
				"ExecutionMode": "SingleCommit",
				"Attributes": {
					"Caption": "Nightly"
				},
				"Tasks": [
					{
						"Step": 0,
						"Parameters": [
							{
								"Name": "pValue",
								"Value": "1"
							}
						]
					}
				]
			},
			"expect": {
				"Active": true,
				"DSTSensitive": false,
				"ExecutionMode": "SingleCommit"
			}
		},
		{
			"id": "a subset's patch keeps its undeclared Alias and ExpandAbove, and leaves out the name a PATCH ignores",
			"type": "Subset",
			"write": "patch",
			"read": {
				"Name": "Top",
				"UniqueName": "[Region].[Region].[Top]",
				"Expression": "{TM1SUBSETALL([Region])}",
				"Alias": "Code",
				"ExpandAbove": true,
				"Attributes": {
					"Caption": "Top"
				}
			},
			"expect": {
				"Expression": "{TM1SUBSETALL([Region])}",
				"Alias": "Code",
				"ExpandAbove": true
			}
		},
		{
			"id": "a process's create keeps its code, parameters and UI data",
			"type": "Process",
			"write": "create",
			"read": {
				"Name": "Load",
				"HasSecurityAccess": false,
				"PrologProcedure": "x = 1;",
				"UIData": "CubeAction=1511\f",
				"VariablesUIData": [
					"VarType=32\f"
				],
				"Parameters": [
					{
						"Name": "pRegion",
						"Prompt": "A region",
						"Value": "North",
						"Type": "String"
					}
				],
				"Attributes": {
					"Caption": "Load"
				}
			},
			"expect": {
				"Name": "Load",
				"HasSecurityAccess": false,
				"PrologProcedure": "x = 1;",
				"UIData": "CubeAction=1511\f",
				"VariablesUIData": [
					"VarType=32\f"
				],
				"Parameters": [
					{
						"Name": "pRegion",
						"Prompt": "A region",
						"Value": "North"
					}
				]
			}
		},
		{
			"id": "a process's patch copies the parameters and variables a PATCH replaces, and leaves out the name it refuses",
			"type": "Process",
			"write": "patch",
			"read": {
				"Name": "Load",
				"PrologProcedure": "x = 1;",
				"UIData": "CubeAction=1511\f",
				"VariablesUIData": [
					"VarType=32\f"
				],
				"Parameters": [
					{
						"Name": "pRegion",
						"Prompt": "A region",
						"Value": "North",
						"Type": "String"
					}
				],
				"Variables": [
					{
						"Name": "vRegion",
						"Type": "String",
						"Position": 1,
						"StartByte": 0,
						"EndByte": 0
					}
				],
				"Attributes": {
					"Caption": "Load"
				}
			},
			"expect": {
				"PrologProcedure": "x = 1;",
				"UIData": "CubeAction=1511\f",
				"VariablesUIData": [
					"VarType=32\f"
				],
				"Parameters": [
					{
						"Name": "pRegion",
						"Prompt": "A region",
						"Value": "North"
					}
				],
				"Variables": [
					{
						"Name": "vRegion",
						"Type": "String",
						"Position": 1,
						"StartByte": 0,
						"EndByte": 0
					}
				]
			}
		},
		{
			"id": "a value whose type has subtypes is copied as its own type",
			"type": "ServerSettings",
			"write": "patch",
			"read": {
				"ServerName": "tm1",
				"EncryptionAtRest": {
					"@odata.type": "#ibm.tm1.api.v1.VaultSettings",
					"KeyRef": "key",
					"ServiceEndpoint": "https://vault"
				}
			},
			"expect": {
				"EncryptionAtRest": {
					"@odata.type": "#ibm.tm1.api.v1.VaultSettings",
					"KeyRef": "key",
					"ServiceEndpoint": "https://vault"
				}
			}
		},
		{
			"id": "a cube's create needs its dimensions",
			"type": "Cube",
			"write": "create",
			"read": {
				"Name": "Sales",
				"Rules": "SKIPCHECK;"
			},
			"error": "Dimensions"
		},
		{
			"id": "a cube's create binds the dimensions a read holds, by key",
			"type": "Cube",
			"write": "create",
			"read": {
				"Name": "Sales",
				"Dimensions": [
					{
						"Name": "Region"
					},
					{
						"Name": "Product"
					}
				]
			},
			"expect": {
				"Name": "Sales",
				"Dimensions@odata.bind": [
					"Dimensions('Region')",
					"Dimensions('Product')"
				]
			}
		},
		{
			"id": "a subset's create binds its elements by UniqueName, in its dimension's own hierarchy too, and with ] escaped",
			"type": "Subset",
			"write": "create",
			"read": {
				"Name": "s",
				"Elements": [
					{
						"Name": "North",
						"UniqueName": "[Region].[Region].[North]"
					},
					{
						"Name": "S]x",
						"UniqueName": "[Region].[S]]x]"
					}
				]
			},
			"expect": {
				"Name": "s",
				"Elements@odata.bind": [
					"Dimensions('Region')/Hierarchies('Region')/Elements('North')",
					"Dimensions('Region')/Hierarchies('Region')/Elements('S%5Dx')"
				]
			}
		},
		{
			"id": "a collection isn't bound when a member's path can't be made",
			"type": "Subset",
			"write": "create",
			"read": {
				"Name": "s",
				"Elements": [
					{
						"Name": "North",
						"UniqueName": "[Region].[Region].[North]"
					},
					{
						"Name": "South"
					}
				]
			},
			"expect": {
				"Name": "s"
			}
		},
		{
			"id": "a view title binds its selected element, not its subset, which could be public or private",
			"type": "ViewTitle",
			"write": "patch",
			"read": {
				"Subset": {
					"Name": "s",
					"UniqueName": "[Region].[Region].[s]"
				},
				"Selected": {
					"Name": "North",
					"UniqueName": "[Region].[Region].[North]"
				}
			},
			"expect": {
				"Selected@odata.bind": "Dimensions('Region')/Hierarchies('Region')/Elements('North')"
			}
		},
		{
			"id": "a user's patch binds the groups a PATCH replaces",
			"type": "User",
			"write": "patch",
			"read": {
				"Name": "u",
				"Groups": [
					{
						"Name": "ADMIN"
					}
				]
			},
			"expect": {
				"Groups@odata.bind": [
					"Groups('ADMIN')"
				]
			}
		},
		{
			"id": "a root's create starts from a read of any of its types, with that type's",
			"type": "View",
			"write": "create",
			"read": {
				"@odata.type": "#ibm.tm1.api.v1.MDXView",
				"Name": "v",
				"MDX": "SELECT {} ON 0 FROM [Sales]"
			},
			"expect": {
				"@odata.type": "#ibm.tm1.api.v1.MDXView",
				"Name": "v",
				"MDX": "SELECT {} ON 0 FROM [Sales]"
			}
		}
	]
}
